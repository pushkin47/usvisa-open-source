# ВАЖНО: АВТОР НЕ ПОДДЕРЖИВАЕТ И НЕ ОДОБРЯЕТ ИСПОЛЬЗОВАНИЕ АВТОМАТИЗИРОВАННЫХ СРЕДСТВ ДЛЯ ВОЗДЕЙСТВИЯ НА РАБОТУ САЙТОВ ПОСОЛЬСТВ, КОНСУЛЬСТВ И ВИЗОВЫХ СИСТЕМ ЛЮБЫХ СТРАН, ВКЛЮЧАЯ США. ПУБЛИКАЦИЯ ПРОЕКТА НЕ ЯВЛЯЕТСЯ ПРИЗЫВОМ К ТАКОМУ ИСПОЛЬЗОВАНИЮ. СОБЛЮДАЙТЕ ПРАВИЛА И ОГРАНИЧЕНИЯ СООТВЕТСТВУЮЩИХ СЕРВИСОВ.
#
# Copy to .env and fill in your own values. Never commit .env or state/.
# Local dashboard administrator. Use a unique password of at least 12 characters.
USVISA_ADMIN_EMAIL=
USVISA_ADMIN_PASSWORD=
USVISA_WEB_PORT=8765
USVISA_MONITOR_AUTOSTART=false
USVISA_MONITOR_LOOP_SECONDS=30
USVISA_WEB_PREVENT_SLEEP=true

# Optional CLI account. In the dashboard, use the user settings form instead.
USVISA_LOGIN_EMAIL=
USVISA_LOGIN_PASSWORD=
# Astana only. The application fixes the facility ID to 134.
USVISA_FACILITY_ID=134
# Your own appointment page and the two matching AIS JSON endpoints.
USVISA_APPOINTMENT_URL=
USVISA_DATES_API_URL=
USVISA_TIMES_API_URL=
USVISA_IGNORED_DATES=
# Empty means no automatic booking. Setting dates enables real booking attempts.
USVISA_PRIORITY_DATES=
USVISA_PREPARATION_DAYS=3
USVISA_MIN_CHECK_INTERVAL_SECONDS=60
USVISA_MAX_CHECK_INTERVAL_SECONDS=300
USVISA_REQUEST_TIMEOUT_SECONDS=30
USVISA_SSL_VERIFY=true

USVISA_BROWSER_HEADLESS=false
USVISA_BROWSER_PROFILE_DIR=state/playwright-profile
USVISA_BROWSER_ACTION_DELAY_MIN_SECONDS=2
USVISA_BROWSER_ACTION_DELAY_MAX_SECONDS=3
USVISA_BROWSER_LOGIN_MAX_ATTEMPTS=2
USVISA_BROWSER_LOGIN_RETRY_DELAY_SECONDS=5
USVISA_BROWSER_KEEP_OPEN_SECONDS=0
USVISA_BROWSER_TRACE_USVISA_NETWORK=false

# Normally populated by browser login. Leave empty for initial setup.
USVISA_BOOTSTRAP_COOKIE=
USVISA_BOOTSTRAP_CSRF_TOKEN=
USVISA_BOOTSTRAP_SESSION_ID=
USVISA_BOOTSTRAP_IF_NONE_MATCH=
USVISA_PREFER_BOOTSTRAP_SESSION=false
USVISA_STATE_FILE=state/usvisa_seen_dates.json
USVISA_WEB_DB_FILE=state/usvisa_web.sqlite3

# Optional: configure your own proxy. No provider or subscription is included.
USVISA_VPN_ENABLED=false
USVISA_VPN_PROXY_URL=
USVISA_VPN_SUBSCRIPTION_URL=
USVISA_VPN_HWID=
USVISA_VPN_SUBSCRIPTION_SSL_VERIFY=true
